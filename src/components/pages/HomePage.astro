  <!-- Floating Toast Notification for BibTeX Copy -->
  <div id="opt-e-toast" class="opt-e-toast" role="status" aria-live="polite"></div>

  <script>
    const toast = document.getElementById('opt-e-toast');
    let toastTimer: number | undefined;

    function showToast(msg: string) {
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      if (toastTimer) window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(() => {
        toast.classList.remove('show');
      }, 2200);
    }

    document.querySelectorAll<HTMLButtonElement>('.copy-bib-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const bibText = btn.getAttribute('data-bib') || '';
        if (!bibText) return;

        if (navigator.clipboard) {
          navigator.clipboard.writeText(bibText).then(() => {
            showToast('✓ BibTeX Copied to Clipboard');
          }).catch(() => {
            showToast('✓ BibTeX Copied');
          });
        } else {
          showToast('✓ BibTeX Copied');
        }
      });
    });
  </script>
