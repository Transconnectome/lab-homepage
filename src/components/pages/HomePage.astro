---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localePath, type Lang } from '../../i18n/ui';
import { memberAnchor } from '../people/MemberGrid';
import { getTodayThemeIndex } from '../../data/dailyThemes';
import { siteMedia } from '../../data/siteMedia';
import ResearchStories from '../home/ResearchStories.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const research = (await getCollection('research'))
  .filter((item) => item.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news'))
  .filter((item) => item.data.lang === lang)
  .sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 3);
// Select three published papers from the latest recorded years. Month metadata
// is incomplete, so this is a selection rather than an exact publication timeline.
const publications = (await getCollection('publications'))
  .filter((item) => item.data.kind !== 'preprint')
  .sort((a, b) => b.data.year - a.data.year || a.data.title.localeCompare(b.data.title))
  .slice(0, 3);
const members = (await getCollection('members'))
  .filter((item) => item.data.category !== 'alumni' && item.data.avatar)
  .sort((a, b) => a.data.order - b.data.order).slice(0, 10);
const todayIndex = getTodayThemeIndex(research.length);
const pageTitle = lang === 'ko' ? '서울대학교 커넥톰 연구실 | SNU Connectome Laboratory' : 'SNU Connectome Laboratory | 서울대학교 커넥톰 연구실';
---

<BaseLayout lang={lang} title={pageTitle} description={t('home.metaDesc')}>
  <section id="introduction" class="section-shell pt-10 pb-12 sm:pt-14 sm:pb-16" aria-labelledby="home-title">
    <div class="grid lg:grid-cols-[1.2fr_0.9fr] gap-12 lg:gap-16 items-center">
      <div class="space-y-7 min-w-0">
        <p class="eyebrow">{t('home.eyebrow')}</p>
        <h1 id="home-title" class="font-display text-[2rem] sm:text-[2.75rem] xl:text-[3.125rem] font-semibold leading-[1.4] text-ink">
          <span class="block">{t('home.missionLead')}</span>
          <span class="block text-oxblood">{t('home.missionFocus')}</span>
        </h1>
        <p class="text-base sm:text-lg text-ink-soft leading-relaxed">{t('home.heroDesc')}</p>
        <nav class="flex flex-wrap gap-x-6 gap-y-3" aria-label={lang === 'ko' ? '연구실 알아보기' : 'Explore the lab'}>
          <a href="#research-questions" class="text-link">{t('home.exploreCta')}</a>
          <a href={localePath(lang, '/publications')} class="text-link">{t('home.allPubs')}</a>
          <a href={localePath(lang, '/join')} class="text-link">{t('home.joinCta')}</a>
        </nav>
        <div class="pt-6 border-t border-line space-y-1" lang="en">
          <p class="font-display text-sm sm:text-base text-ink-soft">Everything Connects to Everything Else.</p>
          <p class="text-xs text-ink-faint">{t('home.mottoCredit')}</p>
        </div>
      </div>
      <figure class="space-y-3 min-w-0">
        <p class="eyebrow">{t('home.figureEyebrow')}</p>
        <a href={siteMedia.hero.source} target="_blank" rel="noreferrer" class="block aspect-square overflow-hidden bg-white" aria-label={siteMedia.hero.alt[lang]}>
        <img src={siteMedia.hero.src} alt={siteMedia.hero.alt[lang]} width={siteMedia.hero.width} height={siteMedia.hero.height}
          fetchpriority="high" class="w-full h-auto" />
        </a>
        <p class="text-sm text-ink-soft leading-relaxed">{siteMedia.hero.guide[lang]}</p>
        <figcaption class="text-sm text-ink-soft leading-relaxed">
          {siteMedia.hero.caption[lang]}
          <a href={siteMedia.hero.source} target="_blank" rel="noreferrer" class="underline underline-offset-4 ml-1">{siteMedia.hero.credit}</a>
          · <a href={siteMedia.hero.license} class="underline underline-offset-4" lang="en">CC BY 4.0</a>
        </figcaption>
        <a href={`${localePath(lang, '/research')}#neuro-x`} class="text-link inline-block text-sm">{t('home.figureLink')}</a>
      </figure>
    </div>
  </section>

  <section id="inquiry" class="border-y border-line" aria-labelledby="inquiry-title">
    <div class="section-shell py-10 sm:py-14 grid grid-cols-1 lg:grid-cols-[0.8fr_1.2fr] gap-7 lg:gap-x-20">
      <div class="space-y-6">
        <div class="space-y-5">
          <p class="eyebrow">{t('home.inquiryEyebrow')}</p>
          <h2 id="inquiry-title" class="font-display text-3xl sm:text-4xl font-semibold">{t('home.inquiryTitle')}</h2>
          <p class="text-base text-ink-soft leading-relaxed">{t('home.connectionDesc')}</p>
        </div>
        <details class="border-t border-line pt-5">
          <summary class="font-display text-xl font-semibold cursor-pointer">{t('home.approachTitle')}</summary>
          <div class="space-y-4 pt-4">
            <p class="text-base text-ink-soft leading-relaxed">{t('home.approachDesc')}</p>
            <a href={`${localePath(lang, '/team')}#pi-perspective`} class="text-link inline-block text-sm">{t('home.piCta')}</a>
          </div>
        </details>

      </div>
      <nav id="research-questions" aria-labelledby="questions-title">
        <h3 id="questions-title" class="eyebrow pb-5 border-b border-ink">{t('home.questionsTitle')}</h3>
        <ol class="divide-y divide-line">
          {research.map((item, index) => (
            <li class="py-4 grid grid-cols-[1.5rem_minmax(0,1fr)] gap-4">
              <span class="text-sm text-oxblood pt-1" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <div class="space-y-3">
                <a href={`${localePath(lang, '/research')}#${item.data.baseSlug ?? item.id}`} class="block font-display text-xl sm:text-[1.375rem] leading-snug font-semibold hover:text-oxblood">
                  {item.data.question}
                </a>
                <p class="text-sm text-ink-soft leading-relaxed">{item.data.tagline}</p>
              </div>
            </li>
          ))}
        </ol>
      </nav>
        <details class="border-t border-line pt-5 mt-2 lg:col-start-2">
          <summary id="perspective-title" class="text-link text-sm cursor-pointer">{lang === 'ko' ? '오늘 살펴볼 연구 질문' : 'A research question for today'}</summary>
          <p class="text-xs text-ink-faint mt-4 mb-3">{lang === 'ko' ? '네 연구 질문 중 하나를 골라 읽어보세요.' : 'Choose one of our four research questions.'}</p>
          <div id="perspective-controls" class="flex flex-wrap gap-2" aria-label={lang === 'ko' ? '연구 질문 선택' : 'Choose a research question'}>
            {research.map((item, i) => <a href={`${localePath(lang, '/research')}#${item.data.baseSlug ?? item.id}`} data-perspective-index={i} class="perspective-choice" aria-label={`${i + 1}. ${item.data.question}`}>{String(i + 1).padStart(2, '0')}</a>)}
          </div>
          <div id="perspective-panels" class="mt-4">
            {research.map((item, i) => <div data-perspective-panel={i} hidden={i !== todayIndex}>
              <a href={`${localePath(lang, '/research')}#${item.data.baseSlug ?? item.id}`} class="text-link leading-relaxed">{item.data.question}</a>
            </div>)}
          </div>
        </details>
    </div>
  </section>

  <ResearchStories lang={lang} />

  <section id="people" class="section-shell py-10 sm:py-14" aria-labelledby="people-title">
    <div class="grid md:grid-cols-[0.9fr_1.1fr] gap-6 md:gap-16 mb-10">
      <h2 id="people-title" class="font-display text-3xl sm:text-4xl font-semibold">{t('home.peopleTitle')}</h2>
      <div class="space-y-5">
        <p class="text-base text-ink-soft leading-relaxed">{t('home.peopleDesc')}</p>
        <details><summary class="text-link cursor-pointer">{lang === 'ko' ? 'AI와 함께 연구한다는 것' : 'Working with AI'}</summary><p class="text-base text-ink-soft leading-relaxed pt-3">{t('home.peopleAi')}</p></details>
        <a href={localePath(lang, '/team')} class="text-link inline-block">{t('home.peopleCta')}</a>
      </div>
    </div>
    <ul class="grid grid-cols-3 sm:grid-cols-5 lg:grid-cols-10 gap-x-3 gap-y-5 sm:gap-4">
      {members.map(({ data: member }) => (
        <li class="min-w-0">
          <a href={`${localePath(lang, '/team')}#${memberAnchor(member.name)}`} class="block group">
            <img src={member.avatar!} alt={lang === 'ko' ? member.nameKo : member.name} width="240" height="300" loading="lazy" class="w-full aspect-[4/5] object-cover object-top" />
            <span class="block text-xs text-ink-soft mt-2 group-hover:underline">{lang === 'ko' ? member.nameKo : member.name}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-10 pt-6 border-t border-line text-base text-ink-soft">
      {t('home.joinDesc')} <a href={localePath(lang, '/join')} class="text-link ml-2">{t('home.joinCta')}</a>
    </p>
  </section>

  <section id="latest" class="border-y border-line bg-white/40" aria-labelledby="latest-title">
    <div class="section-shell py-10 sm:py-14">
      <div class="flex flex-wrap items-baseline justify-between gap-4 mb-10">
        <h2 id="latest-title" class="min-w-0 font-display text-3xl sm:text-4xl font-semibold">{t('home.currentTitle')}</h2>
        {news[0] && <p class="text-sm text-ink-faint">{t('home.updated')} <time class="font-mono ml-2" datetime={news[0].data.date}>{news[0].data.date}</time></p>}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-[1.35fr_1fr] gap-12 lg:gap-20">
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-4 pb-4 border-b border-ink">
            <h3 class="text-lg font-semibold">{t('home.newsHeading')}</h3>
            <a href={localePath(lang, '/news')} class="text-link text-sm">{t('home.allNews')}</a>
          </div>
          <ul class="divide-y divide-line">
            {news.map((item) => (
              <li class="py-6 space-y-2">
                <time datetime={item.data.date} class="font-mono text-xs text-ink-faint">{item.data.date}</time>
                <a href={`${localePath(lang, '/news')}#news-${item.data.baseSlug ?? item.id}`} class="block font-display text-xl leading-snug font-semibold hover:text-oxblood">{item.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-4 pb-4 border-b border-ink">
            <h3 class="text-lg font-semibold">{t('home.publicationsHeading')}</h3>
            <a href={localePath(lang, '/publications')} class="text-link text-sm">{t('home.allPubs')}</a>
          </div>
          <ul class="divide-y divide-line">
            {publications.map(({ data: pub }) => (
              <li class="py-6 space-y-2">
                <p class="text-xs text-ink-faint"><time datetime={String(pub.year)} class="font-mono">{pub.year}</time> · <span lang="en">{pub.venue}</span></p>
                <a href={pub.url ?? (pub.doi ? `https://doi.org/${pub.doi}` : localePath(lang, '/publications'))} class="block font-semibold leading-relaxed hover:text-oxblood" lang="en">{pub.title}</a>
                <p class="text-sm text-ink-faint" lang="en">{pub.authors.length > 3 ? `${pub.authors.slice(0, 3).join(', ')} et al.` : pub.authors.join(', ')}</p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { getTodayThemeIndex } from '../../data/dailyThemes';
    const controls = document.getElementById('perspective-controls');
    const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-perspective-panel]'));
    if (controls && panels.length) {
      const buttons = Array.from(controls.querySelectorAll<HTMLAnchorElement>('a')).map((link, index) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = link.className;
        button.textContent = link.textContent;
        button.setAttribute('aria-label', link.getAttribute('aria-label') || '');
        button.setAttribute('aria-controls', `perspective-panel-${index}`);
        panels[index].id = `perspective-panel-${index}`;
        link.replaceWith(button);
        button.addEventListener('click', () => select(index));
        return button;
      });
      function select(index: number) {
        buttons.forEach((button, i) => button.setAttribute('aria-pressed', String(i === index)));
        panels.forEach((panel, i) => panel.hidden = i !== index);
      }
      select(getTodayThemeIndex(panels.length));
    }
  </script>
  <style is:global>
    .perspective-choice { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; border: 1px solid #d6d3d1; background: transparent; color: #801818; font: inherit; cursor: pointer; }
    .perspective-choice[aria-pressed="true"] { background: #801818; color: white; border-color: #801818; }
    .perspective-choice:hover { text-decoration: underline; }
    .perspective-choice:focus-visible { outline: 3px solid #801818; outline-offset: 3px; }
  </style>
</BaseLayout>
