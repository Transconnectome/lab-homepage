---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localePath, type Lang } from '../../i18n/ui';
import { siteMedia } from '../../data/siteMedia';
import { memberAnchor } from '../people/MemberGrid';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

// 1. Research inquiries
const research = (await getCollection('research'))
  .filter((item) => item.data.lang === lang)
  .sort((a, b) => a.data.order - b.data.order);

// 2. Members: PI + Active fellows with avatars
const allMembers = await getCollection('members');
const sortedMembers = allMembers.map((m) => m.data).sort((a, b) => a.order - b.order);
const pi = sortedMembers.find((m) => m.category === 'pi');
const fellows = sortedMembers
  .filter((m) => m.category !== 'pi' && m.category !== 'alumni' && m.avatar)
  .slice(0, 8);

// 3. Featured Publications & Top Papers
const publications = (await getCollection('publications'))
  .filter((item) => item.data.kind !== 'preprint')
  .sort((a, b) => (b.data.featured ? 1 : 0) - (a.data.featured ? 1 : 0) || b.data.year - a.data.year || a.data.title.localeCompare(b.data.title))
  .slice(0, 3);

// 4. Latest News
const news = (await getCollection('news'))
  .filter((item) => item.data.lang === lang)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 3);

const pageTitle = lang === 'ko'
  ? '서울대학교 커넥톰 연구실 | SNU Connectome Laboratory'
  : 'SNU Connectome Laboratory | 서울대학교 커넥톰 연구실';

// Helper for dynamic BibTeX generation
function getBibtex(pub: { title: string; authors: string[]; venue: string; year: number; doi?: string | null }) {
  const first = pub.authors[0]?.split(' ').pop()?.toLowerCase().replace(/[^a-z0-9]/g, '') || 'author';
  const key = `${first}${pub.year}${pub.title.split(' ')[0].toLowerCase().replace(/[^a-z0-9]/g, '')}`;
  return `@article{${key},
  title={${pub.title}},
  author={${pub.authors.join(' and ')}},
  journal={${pub.venue}},
  year={${pub.year}}${pub.doi ? `,\n  doi={${pub.doi}}` : ''}
}`;
}

const mbbnBibtex = `@article{lee2025multiscale,
  title={Multi-scale biological networks encode adolescent mental health dynamics},
  author={Lee, Ahhyun and Wang, Heehwan and Park, David Keetae and Cha, Jiook},
  journal={Nature Communications},
  year={2025}
}`;
---

<BaseLayout lang={lang} title={pageTitle} description={t('home.metaDesc')}>
  <div class="section-shell">
    <!-- Hero Section: The Restrained Monograph -->
    <section id="introduction" class="pt-10 pb-10 sm:pt-16 sm:pb-14" aria-labelledby="home-title">
      <div class="opt-e-hero-eyebrow">
        {lang === 'ko' ? 'Laboratory Prospectus · 2026 / 서울대학교 심리학과 · 커넥톰 연구실' : 'Laboratory Prospectus · 2026 / Seoul National University · Connectome Laboratory'}
      </div>

      <h1 id="home-title" class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-medium leading-[1.25] text-ink tracking-tight mb-7">
        {lang === 'ko' ? (
          <>
            뇌는 카메라가 아니라,<br class="hidden sm:inline" />
            어둠 속에 가설을 쏘아 올리는 <span class="italic font-normal">프로젝터</span>다.
          </>
        ) : (
          <>
            The brain is not a camera.<br class="hidden sm:inline" />
            It is a projector, casting <span class="italic font-normal">preformed conjectures</span> into the dark.
          </>
        )}
      </h1>

      <p class="text-base sm:text-lg text-ink-soft leading-relaxed max-w-3xl mb-8">
        {lang === 'ko' ? (
          <>
            우리는 100조 개의 시냅스 연결망과 유전체, 4차원 신경 동역학을 통해 인간 마음의 숨은 기하학을 탐구합니다.
            인간을 기계 부품으로 환원하기 위함이 아닙니다. <strong class="text-ink font-semibold">어둠 속에서 가설을 던지고, 그 가설이 현실과 어긋나 산산조각 나는 순간(예측 오차)에서
            어떻게 배움과 회복탄력성, 그리고 숭고한 경외(Awe)라는 영혼이 피어나는가</strong>를 묻습니다.
          </>
        ) : (
          <>
            We explore the hidden geometry of mind through 100 trillion synaptic connections, genomics, and 4D spatiotemporal dynamics.
            Not to reduce human beings to mechanical components, but to ask <strong class="text-ink font-semibold">how learning, resilience, and the sublime emotion of awe emerge from the very moment preformed conjectures collide with reality and shatter into prediction errors</strong>.
          </>
        )}
      </p>

      <!-- Editorial In-page Navigation Jumps -->
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2 pt-5 border-t border-line text-xs font-mono tracking-wider uppercase" aria-label="Prospectus Index">
        <a href="#paradigm" class="text-ink-soft hover:text-oxblood transition-colors">01 {lang === 'ko' ? '근본 질문' : 'Premise'}</a>
        <span class="text-line" aria-hidden="true">/</span>
        <a href="#inquiry" class="text-ink-soft hover:text-oxblood transition-colors">02 {lang === 'ko' ? '연구 축' : 'Inquiries'}</a>
        <span class="text-line" aria-hidden="true">/</span>
        <a href="#evidence" class="text-ink-soft hover:text-oxblood transition-colors">03 {lang === 'ko' ? '관찰 데이터' : 'Findings'}</a>
        <span class="text-line" aria-hidden="true">/</span>
        <a href="#fellows" class="text-ink-soft hover:text-oxblood transition-colors">04 {lang === 'ko' ? '연구진' : 'People'}</a>
        <span class="text-line" aria-hidden="true">/</span>
        <a href="#publications" class="text-ink-soft hover:text-oxblood transition-colors">05 {lang === 'ko' ? '논문 및 소식' : 'Papers & News'}</a>
        <span class="text-line" aria-hidden="true">/</span>
        <a href="#prospectus" class="text-ink-soft hover:text-oxblood transition-colors">06 {lang === 'ko' ? '참여 안내' : 'Contact'}</a>
      </nav>
    </section>

    <!-- Summary Strip -->
    <div class="opt-e-summary-strip">
      <div class="opt-e-summary-item">
        <div class="num">100T</div>
        <div class="label">Synaptic Scale</div>
        <div class="desc">
          {lang === 'ko' ? '대뇌피질 360개 영역의 위상학적 연결망 기저' : 'Topological foundation across 360 cortical areas'}
        </div>
      </div>
      <div class="opt-e-summary-item">
        <div class="num">11.8k</div>
        <div class="label">ABCD Cohort</div>
        <div class="desc">
          {lang === 'ko' ? '유전체(PRS)와 환경이 청소년기 마음에 남기는 10년 종단 궤적' : '10-year longitudinal trajectories linking genomics, environment, and mind'}
        </div>
      </div>
      <div class="opt-e-summary-item">
        <div class="num">4D</div>
        <div class="label">Spatiotemporal Models</div>
        <div class="desc">
          {lang === 'ko' ? 'SwiFT와 DIVER를 통한 시계열 뇌 표현 및 개인 식별' : 'Spatiotemporal representation and individual fingerprinting via SwiFT & DIVER'}
        </div>
      </div>
      <div class="opt-e-summary-item">
        <div class="num">Inside-Out</div>
        <div class="label">Predictive Processing</div>
        <div class="desc">
          {lang === 'ko' ? '통제된 환각(가설)과 예측 오차를 통한 의식의 발현' : 'Emergence of mind through controlled hallucinations and prediction error'}
        </div>
      </div>
    </div>

    <!-- SECTION 01: FOUNDATIONAL PREMISE -->
    <section class="opt-e-section" id="paradigm" aria-labelledby="paradigm-title">
      <div class="opt-e-section-header">
        <span class="opt-e-section-num">01 / The Foundational Premise</span>
        <h2 id="paradigm-title" class="opt-e-section-title">
          {lang === 'ko' ? '우리가 탐구하는 근본 질문' : 'The Foundational Premise'}
        </h2>
      </div>

      <div class="opt-e-essay-grid">
        <div class="opt-e-essay-col">
          <h3>{lang === 'ko' ? '인사이드-아웃: 뇌는 수동적 수광판이 아니다' : 'Inside-Out: The Brain Is Not a Passive Receptor'}</h3>
          <p>
            {lang === 'ko' ? (
              <>
                전통적인 신경과학의 외부-내부(Outside-In) 관점은 뇌를 감각 입력을 수동적으로 받아들여 처리하는 카메라로 바라보았습니다.
                그러나 실제 뇌는 자극이 주어지기 전부터 내부에서 스스로 발화 궤적을 만들어내는 <strong>사전 재생(Preplay)의 동역학</strong>을 갖추고 있습니다.
              </>
            ) : (
              <>
                Traditional neuroscience often adopted an outside-in stance, viewing the brain as an exposure camera passively recording sensory inputs.
                Yet the biological brain exhibits <strong>preplay dynamics</strong>, continually projecting endogenous firing trajectories prior to sensory impingement.
              </>
            )}
          </p>
          <p>
            {lang === 'ko' ? (
              <>
                피아노 건반의 수가 88개로 유한하더라도 천문학적인 선율을 낳듯이, 뇌는 태어날 때부터 유한한 시냅스 기저 위에서 무수한 가설의 멜로디를 연주합니다.
                우리가 경험하는 현실은 뇌가 칠흑 같은 두개골 속에서 직조하는 <strong>통제된 환각(Controlled Hallucination)</strong>입니다.
              </>
            ) : (
              <>
                Just as eighty-eight keys yield astronomical melodies, the brain plays preconfigured conjectures upon a finite synaptic substrate.
                Conscious reality is a <strong>controlled hallucination</strong> woven within the pitch-black vault of the cranium.
              </>
            )}
          </p>
          <div class="opt-e-pullquote">
            {lang === 'ko'
              ? '“배움의 유일한 화폐는 예측 오차(Prediction Error)다. 가설이 현실과 부딪혀 박살 나는 순간에서만 뇌는 세계의 지도를 다시 그린다.”'
              : '“The sole currency of learning is prediction error. Only when a conjecture collides with reality and shatters does the brain redraw its map of the world.”'}
          </div>
        </div>

        <div class="opt-e-essay-col">
          <h3>{lang === 'ko' ? '기계론적 환원을 넘어: 고통과 경외의 생물학적 기저' : 'Beyond Mechanical Reductionism: The Biology of Suffering and Awe'}</h3>
          <p>
            {lang === 'ko' ? (
              <>
                도스토옙스키는 《지하생활자의 수기》에서 자연 법칙과 수학으로 인간을 완전히 계산할 수 있다면 인간은 단지 ‘피아노 건반’이나 기계 부품에 불과하지 않은가라고 절규했습니다.
                우리는 이 실존적 긴장을 결코 외면하지 않습니다.
              </>
            ) : (
              <>
                In <em>Notes from Underground</em>, Dostoevsky cried out: if man can be fully formulated by natural laws and mathematics, is he not merely an organ stop or a piano key? We do not look away from this existential tension.
              </>
            )}
          </p>
          <p>
            {lang === 'ko' ? (
              <>
                우리가 최첨단 4차원 인공지능과 유전체 코호트로 뇌의 생물학적 건반을 해독하는 이유는, 인간을 한낱 기계로 격하하기 위함이 아닙니다.
                오히려 <strong class="text-ink font-semibold">왜 인간은 우울과 고통에 빠지는가, 왜 불합리하게 타인의 슬픔에 공감하는가, 그리고 왜 예술과 광활한 자연 앞에서 자아를 잊고 전율(Awe)하는가</strong>라는 가장 깊은 물음에 과학의 언어로 정직하게 답하기 위함입니다.
              </>
            ) : (
              <>
                Our pursuit of 4D foundation models and longitudinal cohorts is not to diminish man to a cog, but to provide an honest, scientific answer to the most enduring questions: <strong class="text-ink font-semibold">Why do we descend into depression and anguish? Why do we empathize with another's pain? And why do we feel transcendent awe before sublime art and the cosmos?</strong>
              </>
            )}
          </p>
          <p>
            {lang === 'ko' ? (
              <>
                우리는 계산신경과학의 엄밀성과 인문학적 성찰이 교차하는 지점에서, 인간 마음의 존엄을 밝히고자 합니다.
              </>
            ) : (
              <>
                At the intersection of computational rigor and humanist reflection, we seek to illuminate the biological dignity of the human mind.
              </>
            )}
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION 02: FOUR CORE RESEARCH INQUIRIES -->
    <section class="opt-e-section" id="inquiry" aria-labelledby="inquiry-title">
      <div id="research-questions" class="sr-only">Research Questions</div>
      <div class="opt-e-section-header">
        <div>
          <span class="opt-e-section-num">02 / Lines of Inquiry</span>
          <h2 id="inquiry-title" class="opt-e-section-title">
            {lang === 'ko' ? '네 가지 연구 축' : 'Four Lines of Inquiry'}
          </h2>
        </div>
        <a href={localePath(lang, '/research')} class="text-link text-sm font-semibold">
          {lang === 'ko' ? '전체 연구 분야 상세 보기 →' : 'Explore All Research Areas →'}
        </a>
      </div>

      <div class="opt-e-inquiry-list">
        <!-- Axis 01 -->
        <div class="opt-e-inquiry-row">
          <div class="opt-e-inquiry-index">AXIS 01</div>
          <div class="opt-e-inquiry-primary">
            <h3>
              <a href={`${localePath(lang, '/research')}#neuro-x`} class="hover:text-oxblood transition-colors">
                {lang === 'ko' ? '4차원 시공간 뇌 파운데이션 모델' : '4D Spatiotemporal Brain Foundation Models'}
              </a>
            </h3>
            <div class="opt-e-inquiry-question">
              {lang === 'ko'
                ? '“시간의 흐름 속에서 신경망의 비선형 궤적은 어떻게 자아의 연속성을 유지하는가?”'
                : '“How do nonlinear neural trajectories preserve identity and continuity across the arrow of time?”'}
            </div>
            <p class="opt-e-inquiry-body">
              {lang === 'ko'
                ? '수천 시간의 안정상태 및 자연주의 fMRI와 고해상도 EEG 시계열을 4차원 트랜스포머(SwiFT)와 동역학 모델(DIVER)로 학습합니다. 정적인 뇌 지도를 넘어, 시간 축 위에서 스스로 가설을 영사하는 뇌의 동적 궤적을 해독하고 개인 고유의 뇌 지문과 정신건강 바이오마커를 추출합니다.'
                : 'Learning from thousands of hours of resting-state and naturalistic fMRI alongside high-density EEG via 4D Transformers (SwiFT) and dynamical state-space models (DIVER). Transcending static atlases, we decode temporal trajectories to extract individual brain fingerprints and psychiatric biomarkers.'}
            </p>
          </div>
          <div class="opt-e-inquiry-spec-block">
            <div class="opt-e-inquiry-spec-item">
              <div class="meta-label">Methodological Core</div>
              <div class="meta-val">SwiFT 4D Transformer · DIVER EEG</div>
            </div>
            <div class="opt-e-inquiry-spec-item">
              <div class="meta-label">Representative Output</div>
              <div class="meta-val">NeurIPS 2024 · ICLR 2024 · NeuroMamba</div>
            </div>
          </div>
        </div>

        <!-- Axis 02 -->
        <div class="opt-e-inquiry-row">
          <div class="opt-e-inquiry-index">AXIS 02</div>
          <div class="opt-e-inquiry-primary">
            <h3>
              <a href={`${localePath(lang, '/research')}#computational-genetics-psychiatry`} class="hover:text-oxblood transition-colors">
                {lang === 'ko' ? '발달 유전체학과 종단 코호트 인과 추론' : 'Developmental Genomics & Longitudinal Causal Inference'}
              </a>
            </h3>
            <div class="opt-e-inquiry-question">
              {lang === 'ko'
                ? '“타고난 유전적 악보와 가정·사회 환경의 마찰 속에서, 뇌는 어떻게 상처 입고 회복하는가?”'
                : '“How does the brain endure friction and cultivate resilience between innate genetic scores and family environments?”'}
            </div>
            <p class="opt-e-inquiry-body">
              {lang === 'ko'
                ? '미국 국립보건원(NIH) ABCD 연구의 청소년 11,875명을 10년간 종단 추적합니다. 다유전자 위험 점수(PRS)와 가족 환경, 신경 영상 데이터를 결합한 다층적 생물학 네트워크를 구축하여, 정신건강의 궤적을 단일 유전자가 아닌 시스템적 마찰과 회복의 관점에서 규명합니다.'
                : 'Tracking 11,875 adolescents over a decade in the NIH ABCD Study. Constructing multi-scale biological networks integrating polygenic risk scores (PRS), neuroimaging, and socio-environmental friction, deciphering psychiatric trajectories not as isolated defects, but as systemic adaptation.'}
            </p>
          </div>
          <div class="opt-e-inquiry-spec-block">
            <div class="opt-e-inquiry-spec-item">
              <div class="meta-label">Data & Cohort</div>
              <div class="meta-val">ABCD Study (N=11,875) Longitudinal</div>
            </div>
            <div class="opt-e-inquiry-spec-item">
              <div class="meta-label">Representative Output</div>
              <div class="meta-val">Nature Communications 2025 (Lee et al.)</div>
            </div>
          </div>
        </div>

        <!-- Axis 03 -->
        <div class="opt-e-inquiry-row">
          <div class="opt-e-inquiry-index">AXIS 03</div>
          <div class="opt-e-inquiry-primary">
            <h3>
              <a href={`${localePath(lang, '/research')}#quantum-machine-learning`} class="hover:text-oxblood transition-colors">
                {lang === 'ko' ? '대뇌피질의 숨겨진 위상 기하학과 양자 매니폴드' : 'Hidden Cortical Topology & Quantum Manifolds'}
              </a>
            </h3>
            <div class="opt-e-inquiry-question">
              {lang === 'ko'
                ? '“100조 개 시냅스가 빚어내는 대뇌피질의 기하학적 주름에는 어떤 수학적 대칭이 숨어 있는가?”'
                : '“What mathematical symmetries lie latent within the folded geometry of 100 trillion synapses?”'}
            </div>
            <p class="opt-e-inquiry-body">
              {lang === 'ko'
                ? 'Glasser 360 영역 기반 고해상도 피질 두께 데이터와 위상 데이터 분석(TDA), 그리고 양자 상태 커널(Quantum State Kernels)을 융합합니다. 고전적 선형 상관관계로는 포착할 수 없는 고차원 뇌 구조 다양체를 기하학적으로 측량합니다.'
                : 'Fusing Glasser 360 morphometric parcellations with topological data analysis (TDA) and quantum state kernels. Surveying high-dimensional cortical manifolds that elude classical linear correlations to chart subtle neurodevelopmental shifts.'}
            </p>
          </div>
          <div class="opt-e-inquiry-spec-block">
            <div class="opt-e-inquiry-spec-item">
              <div class="meta-label">Approach</div>
              <div class="meta-val">Glasser 360 Morphometry · Quantum ML</div>
            </div>
            <div class="opt-e-inquiry-spec-item">
              <div class="meta-label">Domain</div>
              <div class="meta-val">Topological Data Analysis & Geometry</div>
            </div>
          </div>
        </div>

        <!-- Axis 04 -->
        <div class="opt-e-inquiry-row">
          <div class="opt-e-inquiry-index">AXIS 04</div>
          <div class="opt-e-inquiry-primary">
            <h3>
              <a href={`${localePath(lang, '/research')}#art-and-neuroscience`} class="hover:text-oxblood transition-colors">
                {lang === 'ko' ? '자연주의 인지신경학과 경외감(Awe)의 신경미학' : 'Naturalistic Cognitive Neuroscience & Neuroaesthetics of Awe'}
              </a>
            </h3>
            <div class="opt-e-inquiry-question">
              {lang === 'ko'
                ? '“인간은 왜 웅장한 예술과 타인의 고통 앞에서 자아를 잊고 경외감에 젖는가?”'
                : '“Why does the self dissolve in awe before sublime art and another\'s sorrow?”'}
            </div>
            <p class="opt-e-inquiry-body">
              {lang === 'ko'
