---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemberGrid from '../people/MemberGrid';
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const allMembers = await getCollection('members');
const memberData = allMembers.map((m) => m.data).sort((a, b) => a.order - b.order);
const pageTitle = lang === 'ko' ? '구성원 | 서울대학교 커넥톰 연구실' : 'People | SNU Connectome Laboratory';
---

<BaseLayout lang={lang} title={pageTitle}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <div class="max-w-2xl space-y-4">
      <p class="eyebrow">{t('people.eyebrow')}</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink tracking-tight">{t('people.title')}</h1>
      <p class="text-lg text-ink-soft leading-relaxed">{t('people.desc')}</p>
    </div>

    <MemberGrid members={memberData} lang={lang} client:load />

    <section class="card p-8 sm:p-12 space-y-8">
      <div class="space-y-2">
        <p class="eyebrow">{t('people.labLifeEyebrow')}</p>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink">{t('people.labLifeTitle')}</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="p-6 rounded-xl bg-paper border border-line space-y-3">
          <div class="text-2xl" aria-hidden="true">🏔️</div>
          <h3 class="font-semibold text-ink">{t('people.retreatTitle')}</h3>
          <p class="text-sm text-ink-soft leading-relaxed">{t('people.retreatDesc')}</p>
        </div>

        <div class="p-6 rounded-xl bg-paper border border-line space-y-3">
          <div class="text-2xl" aria-hidden="true">🌍</div>
          <h3 class="font-semibold text-ink">{t('people.fellowshipTitle')}</h3>
          <p class="text-sm text-ink-soft leading-relaxed">{t('people.fellowshipDesc')}</p>
        </div>

        <div class="p-6 rounded-xl bg-paper border border-line space-y-3">
          <div class="text-2xl" aria-hidden="true">🎨</div>
          <h3 class="font-semibold text-ink">{t('people.artTitle')}</h3>
          <p class="text-sm text-ink-soft leading-relaxed">{t('people.artDesc')}</p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
