---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localePath, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const allIdeas = await getCollection('ideas');
const sortedIdeas = allIdeas.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const pick = (en: string, ko?: string | null) => (lang === 'ko' && ko ? ko : en);
const pageTitle = lang === 'ko' ? 'AI 아이디어 랩 | 서울대학교 커넥톰 연구실' : 'AI Idea Lab | SNU Connectome Laboratory';
---

<BaseLayout lang={lang} title={pageTitle}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="max-w-2xl space-y-4">
      <p class="eyebrow">{t('ideas.eyebrow')}</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink tracking-tight">{t('ideas.title')}</h1>
      <p class="text-lg text-ink-soft leading-relaxed measure">{t('ideas.desc')}</p>
      <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-sm text-amber-900 leading-relaxed">
        <strong>{t('ideas.honestyTitle')}</strong> {t('ideas.honestyBody')}
      </div>
    </div>

    <div class="space-y-6">
      {sortedIdeas.map((idea) => (
        <article class="card p-7 sm:p-9 space-y-5">
          <header class="space-y-2">
            <div class="flex flex-wrap items-center gap-2">
              <span class="chip-accent">{idea.data.date}</span>
              <span class="chip">🤖 {idea.data.generatedBy.replace('llm:', '')}</span>
            </div>
            <h2 class="font-display text-xl sm:text-2xl font-semibold text-ink leading-snug">
              {lang === 'ko' && idea.data.titleKo ? idea.data.titleKo : idea.data.title}
            </h2>
            {lang === 'ko'
              ? <p class="text-sm text-ink-faint">{idea.data.title}</p>
              : idea.data.titleKo && <p class="text-sm text-ink-faint">{idea.data.titleKo}</p>}
          </header>

          <div class="p-4 rounded-xl bg-paper border border-line">
            <div class="eyebrow mb-1.5">{t('ideas.hypothesis')}</div>
            <p class="text-base text-ink leading-relaxed measure">{pick(idea.data.hypothesis, idea.data.hypothesisKo)}</p>
          </div>

          <div class="space-y-1.5">
            <div class="eyebrow">{t('ideas.whyNow')}</div>
            <p class="text-base text-ink-soft leading-relaxed measure">{pick(idea.data.rationale, idea.data.rationaleKo)}</p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div class="space-y-1.5">
              <div class="eyebrow">{t('ideas.buildsOn')}</div>
              <ul class="space-y-1">
                {idea.data.labThreads.map((th) => (
                  <li class="text-sm text-ink-soft flex items-start gap-2">
                    <span class="text-lab-700 mt-0.5">·</span>
                    <span>{th}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="space-y-1.5">
              <div class="eyebrow">{t('ideas.inspiration')}</div>
              <ul class="space-y-1">
                {idea.data.externalInspiration.map((th) => (
                  <li class="text-sm text-ink-soft flex items-start gap-2">
                    <span class="text-lab-700 mt-0.5">·</span>
                    <span>{th}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="space-y-1.5">
            <div class="eyebrow">{t('ideas.firstExperiment')}</div>
            <p class="text-base text-ink-soft leading-relaxed measure">{pick(idea.data.firstExperiment, idea.data.firstExperimentKo)}</p>
          </div>

          <div class="pt-4 border-t border-line space-y-1.5">
            <div class="eyebrow">{t('ideas.howFails')}</div>
            <p class="text-sm text-ink-faint leading-relaxed measure">{pick(idea.data.risks, idea.data.risksKo)}</p>
          </div>
        </article>
      ))}
    </div>

    {sortedIdeas.length === 0 && (
      <div class="text-center py-16 card">
        <h2 class="text-lg font-semibold text-ink mb-1">{t('ideas.empty')}</h2>
        <p class="text-sm text-ink-soft">{t('ideas.emptyDesc')}</p>
      </div>
    )}

    <div class="card p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      <p class="text-base text-ink-soft leading-relaxed max-w-lg">{t('ideas.ctaDesc')}</p>
      <a
        href={localePath(lang, '/join')}
        class="px-6 py-3 rounded-lg bg-lab-700 hover:bg-lab-800 text-white font-semibold text-base transition-colors shrink-0"
      >
        {t('ideas.cta')}
      </a>
    </div>
  </div>
</BaseLayout>
