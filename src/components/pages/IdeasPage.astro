---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeasFilter from '../ideas/IdeasFilter';
import { getCollection } from 'astro:content';
import { useTranslations, localePath, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const allIdeas = await getCollection('ideas');
const sortedIdeas = allIdeas
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((idea) => ({ slug: idea.id, ...idea.data }));

const pageTitle = lang === 'ko' ? 'AI 아이디어 랩 | 서울대학교 커넥톰 연구실' : 'AI Idea Lab | SNU Connectome Laboratory';
---

<BaseLayout lang={lang} title={pageTitle}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <div class="max-w-2xl space-y-4">
      <p class="eyebrow">{t('ideas.eyebrow')}</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink tracking-tight">{t('ideas.title')}</h1>
      <p class="text-lg text-ink-soft leading-relaxed">{t('ideas.desc')}</p>
      <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-sm text-amber-900 leading-relaxed">
        <strong>{t('ideas.honestyTitle')}</strong> {t('ideas.honestyBody')}
      </div>
    </div>

    <IdeasFilter ideas={sortedIdeas} lang={lang} client:visible />

    {sortedIdeas.length === 0 && (
      <div class="text-center py-16 card">
        <h2 class="text-lg font-semibold text-ink mb-1">{t('ideas.empty')}</h2>
        <p class="text-sm text-ink-soft">{t('ideas.emptyDesc')}</p>
      </div>
    )}

    <div class="card p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-5">
      <p class="text-base text-ink-soft leading-relaxed max-w-lg">{t('ideas.ctaDesc')}</p>
      <a
        href={localePath(lang, '/join')}
        class="px-6 py-3 rounded-lg bg-lab-700 hover:bg-lab-800 text-white font-semibold text-base transition-colors shrink-0"
      >
        {t('ideas.cta')}
      </a>
    </div>
  </div>
</BaseLayout>
