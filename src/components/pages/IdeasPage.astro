---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IdeasFilter from '../ideas/IdeasFilter';
import { getCollection } from 'astro:content';
import { useTranslations, localePath, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const allIdeas = await getCollection('ideas');
const sortedIdeas = allIdeas
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .map((idea) => ({ slug: idea.id, ...idea.data }));

const pageTitle = lang === 'ko' ? 'AI 아이디어 랩 | 서울대학교 커넥톰 연구실' : 'AI Idea Lab | SNU Connectome Laboratory';
---

<BaseLayout lang={lang} title={pageTitle}>
  <div class="section-shell py-12 sm:py-16">
    <div class="max-w-4xl space-y-10">
      <header class="max-w-3xl space-y-4">
        <p class="eyebrow">{t('ideas.eyebrow')}</p>
        <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink">{t('ideas.title')}</h1>
        <p class="text-lg text-ink-soft leading-relaxed">{t('ideas.desc')}</p>
        <p class="text-sm text-ink-soft leading-relaxed">
          {t('ideas.introNote')}
          <a href="#ideas-provenance" class="text-link ml-1">{t('ideas.provenanceLink')}</a>
        </p>
      </header>

      {sortedIdeas.length > 0 ? (
        <IdeasFilter ideas={sortedIdeas} lang={lang} client:visible />
      ) : (
        <div class="border-t border-line py-10 space-y-2">
          <h2 class="text-lg font-semibold text-ink">{t('ideas.empty')}</h2>
          <p class="text-sm text-ink-soft">{t('ideas.emptyDesc')}</p>
        </div>
      )}

      <aside id="ideas-provenance" aria-labelledby="ideas-provenance-title" class="border-t border-line pt-6 space-y-3 max-w-3xl">
        <h2 id="ideas-provenance-title" class="text-sm font-semibold text-ink">{t('ideas.provenanceTitle')}</h2>
        <p class="text-sm text-ink-soft leading-relaxed">{t('ideas.honestyBody')}</p>
        <p class="text-sm text-ink-soft leading-relaxed">
          {t('ideas.ctaDesc')}
          <a href={localePath(lang, '/join')} class="text-link ml-1">{t('ideas.cta')}</a>
        </p>
      </aside>
    </div>
  </div>
</BaseLayout>
