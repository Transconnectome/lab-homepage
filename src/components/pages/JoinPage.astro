---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinFaq from '../common/JoinFaq.astro';
import { useTranslations, localePath, type Lang } from '../../i18n/ui';
import { researchStories } from '../../data/researchStories';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const pageTitle = lang === 'ko' ? '함께하기 | 서울대학교 커넥톰 연구실' : 'Join Us | SNU Connectome Laboratory';
---

<BaseLayout lang={lang} title={pageTitle}>
  <div class="section-shell py-14 sm:py-20 space-y-14">
    <div class="max-w-3xl space-y-4 border-b border-ink pb-10">
      <p class="eyebrow">{t('join.eyebrow')}</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink tracking-tight">{t('join.title')}</h1>
      <p class="text-lg text-ink-soft leading-relaxed">{t('join.desc')}</p>
      <a href="#applications" class="text-link inline-block text-sm">{t('join.applyTitle')}</a>
    </div>

    <section aria-labelledby="research-practice-title" class="grid lg:grid-cols-[0.7fr_1.3fr] gap-6 lg:gap-16">
      <h2 id="research-practice-title" class="font-display text-2xl font-semibold text-ink">{t('join.researchTitle')}</h2>
      <div class="space-y-5 measure text-base text-ink-soft leading-relaxed">
        <p>{t('join.researchPractice')}</p>
        <p>{t('join.researchThinking')}</p>
        <p>{t('join.researchResponsibility')}</p>
      </div>
    </section>

    <section id="reading-path" class="border-y border-line py-8 grid lg:grid-cols-[0.7fr_1.3fr] gap-6 lg:gap-16" aria-labelledby="reading-path-title">
      <div class="space-y-3">
        <p class="eyebrow">{lang === 'ko' ? '지원 전, 생각의 출발점' : 'Before you apply'}</p>
        <h2 id="reading-path-title" class="font-display text-2xl font-semibold">{lang === 'ko' ? '당신의 질문으로 이어 읽기' : 'Read toward your own question'}</h2>
        <p class="text-sm text-ink-soft leading-relaxed">{lang === 'ko' ? '관심사를 정리하기 위한 선택 안내입니다. 추가 제출 과제가 아닙니다.' : 'An optional way to develop your interests, not an additional application requirement.'}</p>
      </div>
      <ol class="space-y-6">
        <li class="grid grid-cols-[1.5rem_1fr] gap-4">
          <span class="text-oxblood" aria-hidden="true">01</span>
          <div class="space-y-2">
            <h3 class="font-semibold">{lang === 'ko' ? '궁금한 현상을 고르세요.' : 'Choose a phenomenon you want to understand.'}</h3>
            <a href={`${localePath(lang, '/')}#research-questions`} class="text-link text-sm">{lang === 'ko' ? '네 연구 질문 살펴보기' : 'Explore the four research questions'}</a>
          </div>
        </li>
        <li class="grid grid-cols-[1.5rem_1fr] gap-4">
          <span class="text-oxblood" aria-hidden="true">02</span>
          <div class="space-y-3">
            <h3 class="font-semibold">{lang === 'ko' ? '사례 하나에서 발견과 한계를 읽으세요.' : 'Read one study for its finding and its limits.'}</h3>
            <ul class="space-y-3 text-sm">
              {researchStories.map((story) => <li><a href={`${localePath(lang, '/')}#story-${story.id}`} class="text-link">{story.title[lang]}</a></li>)}
            </ul>
          </div>
        </li>
        <li class="grid grid-cols-[1.5rem_1fr] gap-4">
          <span class="text-oxblood" aria-hidden="true">03</span>
          <div class="space-y-2">
            <h3 class="font-semibold">{lang === 'ko' ? '다음에 묻고 싶은 질문을 적어 보세요.' : 'Write the question you would ask next.'}</h3>
            <p class="text-sm text-ink-soft leading-relaxed">{lang === 'ko' ? '무엇이 궁금하고 왜 중요한가요? 어떤 관측이나 비교가 도움이 될까요? 아래 지원 안내의 연구 관심 소개를 준비할 때 활용해 보세요.' : 'What interests you, and why does it matter? Which observations or comparisons could help? Use this reflection when preparing the research-interest paragraphs described below.'}</p>
            <a href="#applications" class="text-link text-sm">{t('join.applyTitle')}</a>
          </div>
        </li>
      </ol>
    </section>

    <!-- Graduate tracks -->
    <section class="space-y-6">
      <div class="space-y-1">
        <p class="eyebrow">{t('join.tracksEyebrow')}</p>
        <h2 class="font-display text-2xl font-semibold text-ink">{t('join.tracksTitle')}</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="border-t border-line pt-5 space-y-3">
          <h3 class="font-semibold text-ink">{t('join.gsai')}</h3>
          <p class="text-sm text-ink-soft leading-relaxed">{t('join.gsaiDesc')}</p>
        </div>
        <div class="border-t border-line pt-5 space-y-3">
          <h3 class="font-semibold text-ink">{t('join.bcs')}</h3>
          <p class="text-sm text-ink-soft leading-relaxed">{t('join.bcsDesc')}</p>
        </div>
        <div class="border-t border-line pt-5 space-y-3">
          <h3 class="font-semibold text-ink">{t('join.psych')}</h3>
          <p class="text-sm text-ink-soft leading-relaxed">{t('join.psychDesc')}</p>
        </div>
      </div>
    </section>

    <!-- Internships -->
    <section class="border-t border-ink pt-8 space-y-4">
      <div class="space-y-1">
        <p class="eyebrow">{t('join.internEyebrow')}</p>
        <h2 class="font-display text-2xl font-semibold text-ink">{t('join.internTitle')}</h2>
      </div>
      <p class="text-base text-ink-soft leading-relaxed measure">{t('join.internDesc')}</p>
    </section>

    <!-- How to apply -->
    <section id="applications" class="border-t border-ink pt-8 space-y-6">
      <div class="space-y-1">
        <p class="eyebrow">{t('join.applyEyebrow')}</p>
        <h2 class="font-display text-2xl font-semibold text-ink">{t('join.applyTitle')}</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-3">
          <h3 class="font-semibold text-lab-800">{t('join.materialsTitle')}</h3>
          <ol class="space-y-2.5 text-base text-ink-soft list-decimal list-inside">
            <li>{t('join.material1')}</li>
            <li>{t('join.material2')}</li>
            <li>{t('join.material3')}</li>
          </ol>
        </div>

        <div class="space-y-4">
          <h3 class="font-semibold text-lab-800">{t('join.sendTitle')}</h3>
          <p class="text-base text-ink-soft leading-relaxed measure">{t('join.sendDesc')}</p>
          <a
            href="mailto:connectome@snu.ac.kr?subject=%5BConnectome%20Lab%20Application%5D"
            class="inline-flex max-w-full [overflow-wrap:anywhere] items-center gap-2 px-6 py-3 rounded-lg bg-lab-700 hover:bg-lab-800 text-white font-semibold text-base transition-colors"
          >
            connectome@snu.ac.kr
          </a>
        </div>
      </div>
    </section>
    <JoinFaq lang={lang} />
  </div>
</BaseLayout>
