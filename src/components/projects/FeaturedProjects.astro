---
import { getCollection } from 'astro:content';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Display labels for the research-map hub ids (see the network enum in content/config.ts).
const NETWORK_LABELS: Record<string, { en: string; ko: string }> = {
  dmn: { en: 'Default Mode', ko: '디폴트 모드' },
  ecn: { en: 'Executive Control', ko: '집행 제어' },
  salience: { en: 'Salience', ko: '돌출성' },
  sensory: { en: 'Sensory', ko: '감각 피질' },
  subcortical: { en: 'Subcortical', ko: '피질하' },
  'eeg-mesh': { en: 'EEG Sensor Mesh', ko: 'EEG 센서 메쉬' },
};

const allPublications = await getCollection('publications');
const pubById = new Map(allPublications.map((p) => [p.id, p]));

// This section answers "what is the lab working on now", so it ranks by real
// activity (the GitHub push date synced weekly) rather than by the editorial
// `order` field — otherwise a long-finished flagship repo sits at the top
// forever. Projects with no recorded push can't be ranked and are skipped.
const featuredProjects = (await getCollection('projects'))
  .filter((p) => !p.data.archived && p.data.lastPush)
  .sort((a, b) => (a.data.lastPush! < b.data.lastPush! ? 1 : -1))
  .slice(0, 4)
  .map((p) => ({
    ...p.data,
    // An unmatched publicationSlug renders the card without a paper link rather than failing the build.
    pub: p.data.publicationSlug ? (pubById.get(p.data.publicationSlug) ?? null) : null,
  }));
---

{
  featuredProjects.length > 0 && (
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="flex items-end justify-between gap-4 mb-8">
        <div>
          <p class="eyebrow">{t('home.projectsEyebrow')}</p>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink mt-2">{t('home.projectsTitle')}</h2>
          <p class="text-sm text-ink-soft mt-2">{t('home.projectsDesc')}</p>
        </div>
        <a
          href="https://github.com/Transconnectome"
          target="_blank"
          rel="noreferrer"
          class="text-sm font-semibold text-lab-700 hover:text-lab-800 transition-colors shrink-0"
        >
          {t('home.allProjects')}
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {featuredProjects.map((proj) => (
          <article class="card card-hover p-6 flex flex-col justify-between gap-4">
            <div class="space-y-2.5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="chip-accent">{NETWORK_LABELS[proj.network]?.[lang] ?? proj.network}</span>
                {proj.highlight && <span class="chip" lang="en">{proj.highlight}</span>}
                {proj.primaryLanguage && <span class="chip" lang="en">{proj.primaryLanguage}</span>}
                {typeof proj.stars === 'number' && proj.stars > 0 && <span class="chip" lang="en">★ {proj.stars}</span>}
              </div>
              <h3 class="font-semibold text-ink leading-snug">
                <a href={proj.repoUrl} target="_blank" rel="noreferrer" class="hover:text-lab-700 transition-colors">
                  {proj.name}
                </a>
              </h3>
              <p class="text-sm text-ink-soft leading-relaxed">
                {lang === 'ko' && proj.blurbKo ? proj.blurbKo : proj.blurb}
              </p>
              {proj.generatedBy && (
                <span class="chip" lang="en" title="Draft blurb generated by AI">
                  🤖 {proj.generatedBy.replace('llm:', '')}
                </span>
              )}
            </div>
            <div class="pt-4 border-t border-line flex items-center justify-between gap-3">
              {proj.pub?.data.url ? (
                <a
                  href={proj.pub.data.url}
                  target="_blank"
                  rel="noreferrer"
                  class="text-sm font-semibold text-lab-700 hover:text-lab-800 transition-colors"
                >
                  {t('home.projectPaper')} · {proj.pub.data.venue} →
                </a>
              ) : (
                <span />
              )}
              {proj.lastPush && (
                <span class="font-mono text-xs text-ink-faint shrink-0">
                  {lang === 'ko'
                    ? `${proj.lastPush.slice(0, 7)} ${t('home.projectUpdated')}`
                    : `${t('home.projectUpdated')} ${proj.lastPush.slice(0, 7)}`}
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}
