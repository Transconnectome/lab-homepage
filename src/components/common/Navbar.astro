---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { label: 'Research', href: '/research' },
  { label: 'Publications', href: '/publications' },
  { label: 'People', href: '/team' },
  { label: 'News', href: '/news' },
  { label: 'History', href: '/history' },
  { label: 'Radar', href: '/radar' },
  { label: 'Ideas', href: '/ideas' },
];
---

<header class="sticky top-0 z-40 w-full border-b border-line bg-paper/90 backdrop-blur-md">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3 group min-w-0">
      <img src="/assets/logo-mark.png" alt="" class="w-8 h-8 shrink-0" />
      <div class="min-w-0">
        <div class="font-display font-semibold text-ink text-base leading-tight truncate">
          Connectome Lab
        </div>
        <div class="font-mono text-[11px] text-ink-faint tracking-wide truncate">
          Seoul National University
        </div>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
            class={`px-3 py-2 rounded-lg text-sm transition-colors ${
              isActive
                ? 'text-lab-800 bg-lab-50 font-semibold'
                : 'text-ink-soft hover:text-ink hover:bg-white'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/join"
        class="hidden sm:inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-lab-700 hover:bg-lab-800 text-white font-semibold text-sm transition-colors"
      >
        Join us
      </a>

      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 rounded-lg border border-line bg-white text-ink-soft hover:text-ink"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-5 border-t border-line bg-paper space-y-1">
    {[...navItems, { label: 'Join us', href: '/join' }].map((item) => (
      <a
        href={item.href}
        class="block px-4 py-2.5 rounded-lg text-base text-ink-soft hover:bg-white hover:text-lab-800 transition-colors"
      >
        {item.label}
      </a>
    ))}
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
  }
</script>
