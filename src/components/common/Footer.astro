---
import { useTranslations, localePath, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const currentYear = new Date().getFullYear();
const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
const labNotes = [
  { label: t('footer.researchRadar'), href: localePath(lang, '/radar') },
  { label: t('footer.ideaLab'), href: localePath(lang, '/ideas') },
];
---

<footer class="border-t border-line bg-white text-ink-soft text-sm py-12 mt-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- About & Leonardo quote -->
      <div class="md:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <img src="/assets/logo-mark.png" alt="" class="w-7 h-7" />
          <span class="font-display font-semibold text-ink">
            {lang === 'ko' ? '서울대학교 커넥톰 연구실' : 'SNU Connectome Laboratory'}
          </span>
        </div>
        <p class="text-sm leading-relaxed" set:html={t('footer.affiliations')} />
      </div>

      <!-- Navigation -->
      <div class="space-y-3">
        <h4 class="eyebrow">{t('footer.navigate')}</h4>
        <ul class="space-y-2">
          <li><a href={localePath(lang, '/research')} class="hover:text-lab-700 transition-colors">{t('nav.research')}</a></li>
          <li><a href={localePath(lang, '/publications')} class="hover:text-lab-700 transition-colors">{t('nav.publications')}</a></li>
          <li><a href={localePath(lang, '/team')} class="hover:text-lab-700 transition-colors">{t('nav.people')}</a></li>
          <li><a href={localePath(lang, '/news')} class="hover:text-lab-700 transition-colors">{t('nav.news')}</a></li>
          <li><a href={localePath(lang, '/join')} class="text-lab-700 font-semibold hover:text-lab-800 transition-colors">{t('nav.join')}</a></li>
        </ul>
        <nav class="pt-5 space-y-3" aria-labelledby="footer-notes-heading">
          <h4 id="footer-notes-heading" class="eyebrow">{t('footer.notes')}</h4>
          <ul class="space-y-2">
            {labNotes.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? 'page' : undefined}
                  class="hover:text-lab-700 transition-colors"
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Contact -->
      <div class="space-y-3">
        <h4 class="eyebrow">{t('footer.contact')}</h4>
        <address class="not-italic space-y-2 leading-relaxed">
          <p set:html={t('footer.address')} />
          <p>
            <a href="mailto:connectome@snu.ac.kr" class="hover:text-lab-700 transition-colors">connectome@snu.ac.kr</a><br />
            <a href="tel:+82-2-880-8618" class="hover:text-lab-700 transition-colors">+82-2-880-8618</a>
          </p>
          <p class="flex flex-col gap-1 pt-1">
            <a href="https://github.com/Transconnectome" target="_blank" rel="noreferrer" class="hover:text-lab-700 transition-colors">GitHub</a>
            <a href="https://scholar.google.com/citations?user=fHSAoOoAAAAJ" target="_blank" rel="noreferrer" class="hover:text-lab-700 transition-colors">Google Scholar</a>
          </p>
        </address>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-line flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-faint">
      <div>© {currentYear} SNU Connectome Lab (PI: Jiook Cha)</div>
      <a href="#top" class="hover:text-ink transition-colors">{t('footer.backToTop')}</a>
    </div>

    <!-- Font attribution, the pattern Naver's font licence recommends.
         The full notice ships with the font at /fonts/maruburi/LICENSE.txt. -->
    <p class="text-xs text-ink-faint">
      {lang === 'ko'
        ? '이 사이트에는 네이버에서 제공한 마루 부리 글꼴이 적용되어 있습니다.'
        : 'This site uses the MaruBuri typeface provided by Naver.'}
    </p>
  </div>
</footer>
