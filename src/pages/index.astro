---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrainViewer from '../components/3d/BrainViewer';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTrends = await getCollection('trends');
const featuredTrends = allTrends.slice(0, 4);

const allPublications = await getCollection('publications');
const featuredPubs = allPublications.filter(p => p.data.featured).slice(0, 4);

const allResearch = await getCollection('research');
const sortedResearch = allResearch.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="SNU Connectome Laboratory | 서울대학교 커넥톰 연구실">
  <!-- Hero Section with 3D Brain Viewer -->
  <section class="relative min-h-[90vh] flex items-center justify-center pt-8 pb-20 overflow-hidden cyber-grid">
    <!-- Ambient glow orbs in background -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>
    <div class="absolute top-1/3 right-10 w-[450px] h-[450px] bg-indigo-500/15 rounded-full blur-[120px] pointer-events-none -z-10"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full space-y-12">
      <!-- Title & Headline -->
      <div class="text-center max-w-4xl mx-auto space-y-6">
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full glass-panel border border-cyan-500/30 text-cyan-300 text-xs font-mono shadow-lg shadow-cyan-500/10">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>THE NEURO-X PROJECT • LARGE BRAIN MODELS</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black text-white tracking-tight leading-[1.1]">
          Uncovering the <span class="neural-gradient-text">Functional Anatomy</span> of Human Connectomes
        </h1>

        <p class="text-base sm:text-lg text-slate-300 max-w-3xl mx-auto leading-relaxed">
          At Seoul National University Connectome Laboratory, we harness multi-modal AI, 4D spatiotemporal foundation models, and multi-omics genetics to decode how neural connections give rise to cognition, emotion, development, and psychiatric resilience.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
          <a
            href="/research"
            class="px-6 py-3.5 rounded-2xl bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 text-slate-950 font-bold text-sm shadow-xl shadow-cyan-500/25 transition-all duration-300 hover:scale-105"
          >
            Explore Research Pillars →
          </a>
          <a
            href="/radar"
            class="px-6 py-3.5 rounded-2xl glass-panel hover:bg-slate-800/80 text-slate-200 border border-slate-700 font-semibold text-sm transition-all duration-300 flex items-center gap-2"
          >
            <span>⚡ Living SOTA Radar</span>
          </a>
        </div>
      </div>

      <!-- 3D Connectome Viewer Canvas -->
      <div class="max-w-5xl mx-auto">
        <BrainViewer client:load />
      </div>
    </div>
  </section>

  <!-- News & Highlights Marquee -->
  <section class="border-y border-slate-800/80 bg-slate-950/60 py-6">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
        <div class="flex items-center gap-2 shrink-0 text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span>Latest Lab News:</span>
        </div>
        <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {sortedNews.slice(0, 3).map((item) => (
            <div class="p-3 rounded-2xl glass-panel border border-slate-800/80 flex items-center justify-between gap-3 text-xs">
              <div class="truncate">
                <span class="font-bold text-slate-200 block truncate">{item.data.title}</span>
                <span class="text-[10px] text-slate-400 font-mono">{item.data.date}</span>
              </div>
              {item.data.link && (
                <a href={item.data.link} target="_blank" rel="noreferrer" class="text-cyan-400 hover:text-cyan-300 shrink-0 font-semibold">
                  ↗
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Research Thrusts Section -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold">Research Pillars</h2>
      <h3 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
        Bridging Neuroscience, AI, and Humanity
      </h3>
      <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
        From large-scale 4D foundation models to transgenerational polygenic genetics and quantum machine learning.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedResearch.map((res) => (
        <a
          href={`/research#${res.slug}`}
          class="rounded-3xl glass-panel glass-panel-hover p-8 border border-slate-800 flex flex-col justify-between group relative overflow-hidden"
        >
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-cyan-500/20 to-indigo-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-300 font-bold text-xl group-hover:scale-110 transition duration-300">
              {res.data.category === 'foundation-models' ? '🧠' : res.data.category === 'genetics' ? '🧬' : res.data.category === 'qml' ? '⚛️' : '🎨'}
            </div>
            <div>
              <h4 class="text-xl font-bold text-white group-hover:text-cyan-300 transition leading-snug">
                {res.data.title}
              </h4>
              <p class="text-xs text-cyan-400 font-mono mt-1">{res.data.titleKo}</p>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              {res.data.tagline}
            </p>
          </div>

          <div class="pt-6 border-t border-slate-800/80 mt-6 flex items-center justify-between text-xs font-semibold text-cyan-400 group-hover:translate-x-1 transition duration-200">
            <span>Read Mission Details</span>
            <span>→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Living SOTA Radar Snapshot -->
  <section class="py-24 border-t border-slate-800/80 bg-slate-950/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/60 text-cyan-300 text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span>LLM-POWERED RESEARCH RADAR</span>
          </div>
          <h3 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
            Latest Research Frontiers & SOTA
          </h3>
          <p class="text-sm text-slate-400 max-w-2xl">
            Automatically curated and synthesized by our research crawlers and LLM analysis pipelines.
          </p>
        </div>
        <a
          href="/radar"
          class="px-5 py-2.5 rounded-2xl glass-panel hover:bg-slate-800 text-cyan-300 border border-cyan-500/40 text-xs font-bold transition flex items-center gap-2 shrink-0"
        >
          <span>View All Radar Reports</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {featuredTrends.map((trend) => (
          <div class="p-6 rounded-3xl glass-panel glass-panel-hover border border-slate-800 space-y-3.5">
            <div class="flex items-center justify-between text-xs">
              <span class="font-semibold text-cyan-400 px-2.5 py-0.5 rounded-full bg-cyan-950 border border-cyan-800">
                {trend.data.topic}
              </span>
              <span class="font-mono text-slate-500">{trend.data.publishedDate}</span>
            </div>
            <h4 class="text-base font-bold text-white leading-snug">
              <a href={trend.data.url} target="_blank" rel="noreferrer" class="hover:text-cyan-300 transition hover:underline">
                {trend.data.title}
              </a>
            </h4>
            <p class="text-xs text-slate-300 font-mono italic">
              {trend.data.source} • {trend.data.authors.join(', ')}
            </p>
            <div class="p-3 rounded-xl bg-slate-950/60 border border-slate-800/80 text-xs text-slate-300 space-y-1">
              {trend.data.summaryPoints.slice(0, 2).map((pt) => (
                <div class="flex items-start gap-1.5">
                  <span class="text-cyan-400">▹</span>
                  <span>{pt}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured Publications Section -->
  <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-3">
        <h2 class="text-xs font-mono uppercase tracking-widest text-cyan-400 font-bold">Scientific Output</h2>
        <h3 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Featured Lab Publications
        </h3>
        <p class="text-sm text-slate-400 max-w-2xl">
          High-impact papers in Nature Communications, Molecular Psychiatry, NeurIPS, and ICML.
        </p>
      </div>
      <a
        href="/publications"
        class="px-5 py-2.5 rounded-2xl glass-panel hover:bg-slate-800 text-cyan-300 border border-cyan-500/40 text-xs font-bold transition flex items-center gap-2 shrink-0"
      >
        <span>Browse All Publications</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredPubs.map((pub) => (
        <div class="p-6 rounded-3xl glass-panel glass-panel-hover border border-slate-800 flex flex-col justify-between space-y-4 group">
          <div class="space-y-2.5">
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-cyan-400 bg-cyan-950 px-2.5 py-0.5 rounded-full border border-cyan-800">
                {pub.data.year}
              </span>
              {pub.data.spotlight && (
                <span class="text-xs text-amber-300 font-semibold px-2 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/30">
                  ✨ {pub.data.spotlight}
                </span>
              )}
            </div>
            <h4 class="text-lg font-bold text-white group-hover:text-cyan-300 transition leading-snug">
              {pub.data.url ? (
                <a href={pub.data.url} target="_blank" rel="noreferrer" class="hover:underline">
                  {pub.data.title}
                </a>
              ) : (
                pub.data.title
              )}
            </h4>
            <p class="text-xs text-slate-300">
              {pub.data.authors.join(', ')}
            </p>
            <p class="text-xs font-mono text-slate-400 italic">{pub.data.venue}</p>
          </div>

          <div class="pt-4 border-t border-slate-800/80 flex items-center gap-3 text-xs">
            {pub.data.url && (
              <a href={pub.data.url} target="_blank" rel="noreferrer" class="text-cyan-400 hover:text-cyan-300 font-semibold flex items-center gap-1">
                <span>Read Paper</span>
                <span>↗</span>
              </a>
            )}
            {pub.data.codeUrl && (
              <a href={pub.data.codeUrl} target="_blank" rel="noreferrer" class="text-indigo-400 hover:text-indigo-300 font-semibold flex items-center gap-1">
                <span>Code</span>
                <span>↗</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Join Us / Call to Action Banner -->
  <section class="py-20 border-t border-slate-800/80">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-10 sm:p-14 rounded-3xl neural-gradient text-slate-950 flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
        <div class="space-y-3 max-w-xl">
          <h3 class="text-2xl sm:text-4xl font-black tracking-tight leading-tight">
            Join the Everlasting Journey of Connectome AI
          </h3>
          <p class="text-xs sm:text-sm font-medium text-slate-900 leading-relaxed">
            We are actively recruiting passionate Graduate Students, Postdocs, and Undergraduate Research Interns in AI, Foundation Models, Quantum ML, and Cognitive Neuroscience.
          </p>
        </div>
        <div class="shrink-0 flex flex-col sm:flex-row gap-3">
          <a
            href="/join"
            class="px-6 py-3.5 rounded-2xl bg-slate-950 hover:bg-slate-900 text-white font-bold text-xs text-center shadow-xl transition hover:scale-105"
          >
            View Recruitment Guide →
          </a>
          <a
            href="mailto:connectome@snu.ac.kr"
            class="px-6 py-3.5 rounded-2xl bg-white/90 hover:bg-white text-slate-950 font-bold text-xs text-center shadow-lg transition"
          >
            Contact PI
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
