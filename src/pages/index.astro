---
import BaseLayout from '../layouts/BaseLayout.astro';
import BrainViewer from '../components/3d/BrainViewer';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allPublications = await getCollection('publications');
const featuredPubs = allPublications
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 4);

const allResearch = await getCollection('research');
const sortedResearch = allResearch.sort((a, b) => a.data.order - b.data.order);

const alumni = (await getCollection('members'))
  .filter((m) => m.data.category === 'alumni' && m.data.affiliations.length > 0)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <!-- Hero: the da Vinci motto as the lab's thesis -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-16 sm:pt-28 sm:pb-20">
    <div class="max-w-3xl space-y-8">
      <p class="eyebrow">Seoul National University · Connectome Laboratory</p>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-semibold text-ink leading-[1.15] tracking-tight">
        Study the science of art.<br />
        <span class="italic text-lab-700">Study the art of science.</span>
      </h1>

      <p class="font-mono text-xs text-ink-faint">— Leonardo da Vinci, the lab’s founding instruction</p>

      <p class="text-lg text-ink-soft leading-relaxed max-w-2xl">
        We study how the brain’s connections give rise to mind — cognition, emotion, development,
        and psychiatric resilience. Our instruments are brain foundation models, multimodal genetics,
        and quantum machine learning; our conviction is that seeing well is a scientific skill.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/research"
          class="px-6 py-3 rounded-lg bg-lab-700 hover:bg-lab-800 text-white font-semibold text-base transition-colors"
        >
          Explore our research
        </a>
        <a
          href="/team"
          class="px-6 py-3 rounded-lg border border-line bg-white hover:border-lab-600/50 text-ink font-semibold text-base transition-colors"
        >
          Meet the people
        </a>
      </div>
    </div>
  </section>

  <!-- The one dark "projection room": interactive connectome sketch -->
  <section class="bg-deep border-y border-deep-line py-14 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.18em] text-cyan-400">The research map</p>
          <h2 class="font-display text-2xl sm:text-3xl font-semibold text-white mt-2">
            Six networks, one lab
          </h2>
        </div>
        <p class="text-sm text-slate-400 max-w-md leading-relaxed">
          An illustrative sketch of the brain networks we study — each node links to real lab projects.
        </p>
      </div>
      <BrainViewer client:visible />
    </div>
  </section>

  <!-- Latest news -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="eyebrow">From the lab</p>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink mt-2">Latest news</h2>
      </div>
      <a href="/news" class="text-sm font-semibold text-lab-700 hover:text-lab-800 transition-colors shrink-0">
        All news →
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {sortedNews.slice(0, 3).map((item) => (
        <article class="card card-hover p-6 flex flex-col gap-3">
          <div class="flex items-center gap-2">
            <span class="chip">{item.data.category}</span>
            <span class="font-mono text-xs text-ink-faint">{item.data.date}</span>
          </div>
          <h3 class="font-semibold text-ink leading-snug">
            {item.data.link ? (
              <a href={item.data.link} target="_blank" rel="noreferrer" class="hover:text-lab-700 transition-colors">
                {item.data.title}
              </a>
            ) : (
              item.data.title
            )}
          </h3>
          {item.data.titleKo && <p class="text-sm text-ink-faint">{item.data.titleKo}</p>}
        </article>
      ))}
    </div>
  </section>

  <!-- Research pillars -->
  <section class="bg-white border-y border-line py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="max-w-2xl">
        <p class="eyebrow">Research</p>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink mt-2">
          From foundation models to art exhibitions
        </h2>
        <p class="text-base text-ink-soft mt-3 leading-relaxed">
          Five directions, one question: how do neural connections become a mind?
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {sortedResearch.map((res) => (
          <a
            href={`/research#${res.slug}`}
            class="card card-hover p-7 flex flex-col justify-between group"
          >
            <div class="space-y-3">
              <h3 class="font-display text-lg font-semibold text-ink group-hover:text-lab-700 transition-colors leading-snug">
                {res.data.title}
              </h3>
              <p class="font-mono text-xs text-lab-700">{res.data.titleKo}</p>
              <p class="text-sm text-ink-soft leading-relaxed">{res.data.tagline}</p>
            </div>
            <div class="pt-5 mt-5 border-t border-line text-sm font-semibold text-lab-700 group-hover:translate-x-1 transition-transform">
              Read more →
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured publications -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink mt-2">Featured publications</h2>
      </div>
      <a href="/publications" class="text-sm font-semibold text-lab-700 hover:text-lab-800 transition-colors shrink-0">
        All {allPublications.length} publications →
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {featuredPubs.map((pub) => (
        <article class="card card-hover p-6 flex flex-col justify-between gap-4">
          <div class="space-y-2.5">
            <div class="flex flex-wrap items-center gap-2">
              <span class="chip-accent">{pub.data.year}</span>
              {pub.data.spotlight && <span class="chip">{pub.data.spotlight}</span>}
            </div>
            <h3 class="font-semibold text-ink leading-snug">
              {pub.data.url ? (
                <a href={pub.data.url} target="_blank" rel="noreferrer" class="hover:text-lab-700 transition-colors">
                  {pub.data.title}
                </a>
              ) : (
                pub.data.title
              )}
            </h3>
            <p class="text-sm text-ink-soft">{pub.data.authors.join(', ')}</p>
            <p class="font-mono text-xs text-ink-faint italic">{pub.data.venue}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Where our people go -->
  <section class="bg-white border-y border-line py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="max-w-2xl">
        <p class="eyebrow">Alumni</p>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink mt-2">Where our people go</h2>
      </div>
      <div class="flex flex-wrap gap-2.5">
        {alumni.map((m) => (
          <span class="chip text-sm py-1.5 px-3.5">
            <span class="font-semibold text-ink mr-1.5">{m.data.name}</span>
            <span class="text-ink-faint">→ {m.data.affiliations[0]}</span>
          </span>
        ))}
      </div>
      <a href="/team" class="inline-block text-sm font-semibold text-lab-700 hover:text-lab-800 transition-colors">
        Meet current members and alumni →
      </a>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="card p-10 sm:p-14 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="space-y-3 max-w-xl">
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink leading-snug">
          Curious about brains, models, or both?
        </h2>
        <p class="text-base text-ink-soft leading-relaxed">
          We welcome graduate students, postdocs, and undergraduate interns from psychology, AI,
          neuroscience, physics, and beyond. Tell us what you want to figure out.
        </p>
      </div>
      <div class="shrink-0 flex flex-col sm:flex-row gap-3">
        <a
          href="/join"
          class="px-6 py-3 rounded-lg bg-lab-700 hover:bg-lab-800 text-white font-semibold text-base text-center transition-colors"
        >
          How to apply
        </a>
        <a
          href="mailto:connectome@snu.ac.kr"
          class="px-6 py-3 rounded-lg border border-line bg-white hover:border-lab-600/50 text-ink font-semibold text-base text-center transition-colors"
        >
          Email the PI
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
