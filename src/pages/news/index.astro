---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const sortedNews = allNews.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const CATEGORY_LABELS: Record<string, string> = {
  award: 'Award',
  paper: 'Paper',
  conference: 'Conference',
  event: 'Event',
  exhibition: 'Exhibition',
  general: 'News',
};
---

<BaseLayout title="News | SNU Connectome Laboratory">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <!-- Header -->
    <div class="max-w-2xl space-y-4">
      <p class="eyebrow">News</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink tracking-tight">
        What's new in the lab
      </h1>
      <p class="text-lg text-ink-soft leading-relaxed">
        Papers accepted, awards won, exhibitions opened — and the people who made them happen.
      </p>
    </div>

    <!-- News list -->
    <div class="space-y-5">
      {sortedNews.map(async (item) => {
        const { Content } = await item.render();
        return (
          <article class="card card-hover p-7 space-y-3">
            <div class="flex items-center gap-2.5">
              <span class="chip-accent">{CATEGORY_LABELS[item.data.category] ?? item.data.category}</span>
              <span class="font-mono text-xs text-ink-faint">{item.data.date}</span>
            </div>
            <h2 class="font-display text-xl font-semibold text-ink leading-snug">
              {item.data.link ? (
                <a href={item.data.link} target="_blank" rel="noreferrer" class="hover:text-lab-700 transition-colors">
                  {item.data.title}
                </a>
              ) : (
                item.data.title
              )}
            </h2>
            {item.data.titleKo && <p class="text-sm text-ink-faint">{item.data.titleKo}</p>}
            <div class="prose prose-stone prose-sm max-w-none prose-a:text-lab-700">
              <Content />
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
