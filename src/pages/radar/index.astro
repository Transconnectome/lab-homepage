---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchRadarView from '../../components/ai/ResearchRadarView';
import { getCollection } from 'astro:content';

const allTrends = await getCollection('trends');
const trendData = allTrends
  .map((t) => t.data)
  .sort((a, b) => new Date(b.publishedDate).getTime() - new Date(a.publishedDate).getTime());
---

<BaseLayout title="Research Radar | SNU Connectome Laboratory">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <!-- Header -->
    <div class="max-w-2xl space-y-4">
      <p class="eyebrow">Research radar</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink tracking-tight">
        What we're reading this week
      </h1>
      <p class="text-lg text-ink-soft leading-relaxed">
        A weekly scan of new arXiv papers in brain foundation models, fMRI/EEG dynamics,
        genomics &amp; connectomics, and quantum machine learning. Summaries are generated by an
        LLM pipeline and labeled by how they were produced; selected lab papers appear alongside.
      </p>
      <p class="text-base text-ink-soft">
        Wondering what these papers could mean for us? Visit the
        <a href="/ideas" class="text-lab-700 hover:text-lab-800 underline font-semibold">AI Idea Lab</a> —
        weekly machine-proposed hypotheses built on this radar.
      </p>
    </div>

    <ResearchRadarView trends={trendData} client:load />
  </div>
</BaseLayout>
