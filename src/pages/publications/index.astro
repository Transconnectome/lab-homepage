---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublicationFilter from '../../components/publications/PublicationFilter';
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const pubData = allPubs.map((p) => p.data).sort((a, b) => b.year - a.year);
const years = pubData.map((p) => p.year);
const minYear = Math.min(...years);
const maxYear = Math.max(...years);
---

<BaseLayout title="Publications | SNU Connectome Laboratory">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-12">
    <!-- Header -->
    <div class="max-w-2xl space-y-4">
      <p class="eyebrow">Publications</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink tracking-tight">
        {pubData.length} papers, {minYear}–{maxYear}
      </h1>
      <p class="text-lg text-ink-soft leading-relaxed">
        The lab's full record — from Nature Communications and Molecular Psychiatry to NeurIPS and
        ICML workshops — synced automatically from OpenAlex and curated by hand. Lab members are
        highlighted in each author list.
      </p>
      <p class="font-mono text-xs text-ink-faint">
        Also on
        <a
          href="https://scholar.google.com/citations?user=d_s86n8AAAAJ"
          target="_blank"
          rel="noreferrer"
          class="text-lab-700 hover:text-lab-800 underline"
        >Google Scholar</a>
      </p>
    </div>

    <PublicationFilter publications={pubData} client:load />
  </div>
</BaseLayout>
