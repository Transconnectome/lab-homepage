---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemberGrid from '../../components/people/MemberGrid';
import { getCollection } from 'astro:content';

const allMembers = await getCollection('members');
const memberData = allMembers.map((m) => m.data).sort((a, b) => a.order - b.order);
---

<BaseLayout title="People | SNU Connectome Laboratory">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    <!-- Header -->
    <div class="max-w-2xl space-y-4">
      <p class="eyebrow">People</p>
      <h1 class="font-display text-3xl sm:text-4xl font-semibold text-ink tracking-tight">
        The people behind the models
      </h1>
      <p class="text-lg text-ink-soft leading-relaxed">
        Psychologists, engineers, physicists, economists, and one art historian — a team at
        Seoul National University that believes good science needs many ways of seeing.
      </p>
    </div>

    <!-- Member grid -->
    <MemberGrid members={memberData} client:load />

    <!-- Lab life -->
    <section class="card p-8 sm:p-12 space-y-8">
      <div class="space-y-2">
        <p class="eyebrow">Lab life</p>
        <h2 class="font-display text-2xl sm:text-3xl font-semibold text-ink">
          Work hard, dream boldly, enjoy life
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        <div class="p-6 rounded-xl bg-paper border border-line space-y-3">
          <div class="text-2xl" aria-hidden="true">🏔️</div>
          <h3 class="font-semibold text-ink">Hongcheon retreats &amp; hackathons</h3>
          <p class="text-sm text-ink-soft leading-relaxed">
            Multi-day deep-dive hackathons in the hills of Gangwon-do: building EEG foundation
            models by day, cooking and debating ideas by night.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-paper border border-line space-y-3">
          <div class="text-2xl" aria-hidden="true">🌍</div>
          <h3 class="font-semibold text-ink">Global fellowships</h3>
          <p class="text-sm text-ink-soft leading-relaxed">
            Students regularly spend funded research terms at MILA (Montreal) and Brookhaven
            National Laboratory (New York) — and come back with new collaborations.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-paper border border-line space-y-3">
          <div class="text-2xl" aria-hidden="true">🎨</div>
          <h3 class="font-semibold text-ink">Art, opera, coffee &amp; cocktails</h3>
          <p class="text-sm text-ink-soft leading-relaxed">
            From interactive EEG art at the OB/Scene festival to the PI's handmade cocktails
            and makgeolli appreciation — creativity thrives on life's finer pleasures.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
